# EduPilot AI Environment Configuration
# Copy this file to .env and replace placeholders with actual credentials if available.

PORT=5000
NODE_ENV=development

# Optional AI API Providers (EduPilot AI automatically falls back to deterministic adaptive AI if unset)
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Maximum upload file size in bytes (default: 10MB)
MAX_FILE_SIZE=10485760

# Demo Mode active by default for guaranteed offline hackathon presentation
DEMO_MODE=true
